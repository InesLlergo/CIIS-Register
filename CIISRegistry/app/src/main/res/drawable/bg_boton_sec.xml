<?xml version="1.0" encoding="utf-8"?>
<!-- Botón/Secundario: blanco con borde rojo -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rojo_suave" />
            <stroke android:width="1.5dp" android:color="@color/rojo" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tarjeta" />
            <stroke android:width="1.5dp" android:color="@color/rojo" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
